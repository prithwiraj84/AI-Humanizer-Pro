# ============================================================
#  AI Humanizer Pro — Frontend (Next.js) environment variables
#  Copy this file to `.env.local` (Next.js loads it automatically).
# ============================================================

# Where the /backend/* proxy forwards to (your FastAPI API).
# Local dev: http://127.0.0.1:5001   |   Prod: https://your-api-domain.com
BACKEND_URL=http://127.0.0.1:5001

# Canonical site URL used for SEO metadata, sitemap & OpenGraph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
