# ============================================================
#  AI Humanizer Pro — Backend (FastAPI) environment variables
#  Copy this file to `.env` and fill in real values.
#  NEVER commit `.env` (it is gitignored). Never share secrets.
# ============================================================

# Signs the session cookie. Keep it stable & secret in production
# (a changing key logs everyone out and breaks multi-worker auth).
# Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-hex-string

# --- Admin console login ---
ADMIN_EMAIL=admin@aih.local
ADMIN_PASSWORD=ChangeAdminPassword123!

# --- SMTP (password-reset OTP emails) ---
# For Gmail: create an App Password at
# Google Account -> Security -> 2-Step Verification -> App Passwords
SENDER_EMAIL=
SENDER_PASSWORD=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
